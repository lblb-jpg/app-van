# Client (Vite) — valeurs depuis Supabase → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY"

# Serveur uniquement (ne jamais exposer au client)
# SUPABASE_SERVICE_ROLE_KEY="YOUR_SERVICE_ROLE_KEY"

# Talkie WebRTC — STUN public par défaut.
# TURN recommandé sur réseaux mobiles / NAT stricts.
# VITE_TURN_URL="turn:turn.example.com:3478"
# VITE_TURN_USERNAME="vanlife"
# VITE_TURN_CREDENTIAL="CHANGE_ME"
